node_modules/
.next/
.env
.env.local
*.log

# 本地界面验收截图与临时浏览器状态
.impeccable/review/

# 运行时上传产物(保留目录占位)
public/uploads/**/*
!public/uploads/**/.gitkeep

# 爬虫原始 CSV 落盘目录(只保留路径,内容不入库)
data/raw/**/*
!data/raw/**/.gitkeep

# 阶段9 · 舆情监控 报告产物(HTML + JSON),中台从分析服务拉回后落这里
storage/opinion-reports/**/*
!storage/opinion-reports/.gitkeep

# 阶段10.3 · 知识库上传原文件留底
storage/knowledge/**/*

# tesseract OCR 运行时下载的语言包(落 CWD)
